NODE_ENV=development

# Google OAuth client credentials, configured in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP / Gmail credentials for sending OTP verification emails
SMTP_USER=
SMTP_PASS=

# Generate a random value of at least 32 characters. Keep it private.
SESSION_SECRET=

# Existing database connection.
DATABASE_URL=

# Directory for uploaded product images. Use persistent storage in production.
PRODUCT_IMAGE_UPLOAD_DIR=uploads/products
