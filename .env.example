NODE_ENV=development

# Google OAuth client credentials, configured in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API key and a verified sender address/domain.
RESEND_API_KEY=
